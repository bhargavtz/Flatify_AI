// Flatify Studio AI - High-Concurrency PostgreSQL Schema (Prisma)
// Optimized for 50,000+ Concurrent Online Users with PgBouncer Connection Pooling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  PRO
  ENTERPRISE
  ADMIN
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ModelEngine {
  FLUX_1_ULTRA
  MIDJOURNEY_V6
  SORA_VIDEO_GEN2
  RUNWAY_GEN3
  FLATIFY_VECTOR_PRO
  MESHY_3D
}

enum CreditTransactionType {
  BONUS
  PURCHASE
  GENERATION_DEDUCTION
  REFUND
}

model User {
  id                 String              @id @default(uuid())
  clerkId            String              @unique @map("clerk_id")
  email              String              @unique
  name               String?
  avatarUrl          String?             @map("avatar_url")
  role               Role                @default(USER)
  credits            Int                 @default(100)
  subscriptionTier   String              @default("FREE") @map("subscription_tier")
  stripeCustomerId   String?             @unique @map("stripe_customer_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  projects           Project[]
  generations        Generation[]
  creditTransactions CreditTransaction[]
  subscriptions      Subscription[]

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

model Project {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  title       String
  description String?
  aspectRatio String       @default("1:1") @map("aspect_ratio")
  isPublic    Boolean      @default(false) @map("is_public")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@index([userId])
  @@map("projects")
}

model Generation {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  projectId     String?          @map("project_id")
  prompt        String
  negativePrompt String?         @map("negative_prompt")
  modelEngine   ModelEngine      @default(FLATIFY_VECTOR_PRO) @map("model_engine")
  modelParams   Json?            @map("model_params")
  outputUrl     String?          @map("output_url")
  vectorSvgCode String?          @map("vector_svg_code")
  status        GenerationStatus @default(PENDING)
  creditsCost   Int              @default(1) @map("credits_cost")
  latencyMs     Int?             @map("latency_ms")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([modelEngine])
  @@index([createdAt])
  @@map("generations")
}

model CreditTransaction {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  amount      Int
  type        CreditTransactionType
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_transactions")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  plan                 String
  status               String
  currentPeriodEnd     DateTime @map("current_period_end")
  createdAt            DateTime @default(now()) @map("created_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model UserPromptHistory {
  id        String   @id @default(uuid())
  clerkId   String   @unique @map("clerk_id")
  prompts   String[]
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clerkId])
  @@map("user_prompt_histories")
}

model StudioWork {
  id           String          @id @default(uuid())
  slug         String          @unique
  clerkId      String          @map("clerk_id")
  kind         String
  prompt       String
  tagline      String
  ratio        String
  paper        String?
  motion       String?
  length       String?
  palette      String[]
  likeCount    Int             @default(0) @map("like_count")
  commentCount Int             @default(0) @map("comment_count")
  featured     Boolean         @default(false)
  createdAt    DateTime        @default(now()) @map("created_at")

  likes        StudioLike[]
  comments     StudioComment[]

  @@index([clerkId])
  @@index([kind])
  @@index([createdAt])
  @@index([likeCount])
  @@map("studio_works")
}

model StudioProfile {
  id          String   @id @default(uuid())
  clerkId     String   @unique @map("clerk_id")
  username    String   @unique
  displayName String   @map("display_name")
  tagline     String   @default("Frames on the table.")
  avatarUrl   String?  @map("avatar_url")
  bio         String?  @default("")
  coverUrl    String?  @map("cover_url")
  location    String?  @default("")
  website     String?  @default("")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([username])
  @@map("studio_profiles")
}

model StudioLike {
  id        String     @id @default(uuid())
  slug      String
  clerkId   String     @map("clerk_id")
  createdAt DateTime   @default(now()) @map("created_at")

  work      StudioWork @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@unique([slug, clerkId])
  @@index([clerkId])
  @@map("studio_likes")
}

model StudioComment {
  id              String     @id @default(uuid())
  slug            String
  clerkId         String     @map("clerk_id")
  authorUsername  String     @map("author_username")
  authorName      String     @map("author_name")
  authorAvatarUrl String?    @map("author_avatar_url")
  body            String
  createdAt       DateTime   @default(now()) @map("created_at")

  work            StudioWork @relation(fields: [slug], references: [slug], onDelete: Cascade)

  @@index([slug])
  @@index([clerkId])
  @@map("studio_comments")
}

model StudioJob {
  id          String   @id @default(uuid())
  clerkId     String   @map("clerk_id")
  kind        String
  prompt      String
  creditsCost Int      @default(0) @map("credits_cost")
  usdCents    Int      @default(0) @map("usd_cents")
  provider    String
  usedOwnKey  Boolean  @default(false) @map("used_own_key")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clerkId])
  @@index([createdAt])
  @@map("studio_jobs")
}

model StudioKey {
  id        String   @id @default(uuid())
  clerkId   String   @map("clerk_id")
  provider  String
  last4     String
  encrypted String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clerkId, provider])
  @@index([clerkId])
  @@map("studio_keys")
}

model StudioAccount {
  id          String   @id @default(uuid())
  clerkId     String   @unique @map("clerk_id")
  plan        String   @default("FREE")
  useOwnKeys  Boolean  @default(false) @map("use_own_keys")
  creditsUsed Int      @default(0) @map("credits_used")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("studio_accounts")
}

model NoviceGeneration {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  businessName        String   @map("business_name")
  businessDescription String   @map("business_description")
  primaryColor        String?  @map("primary_color")
  secondaryColor      String?  @map("secondary_color")
  logoDataUri         String   @map("logo_data_uri")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("novice_generations")
}

model ProfessionalGeneration {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  originalPrompt String?  @map("original_prompt")
  refinedPrompt  String?  @map("refined_prompt")
  usedPrompt     String   @map("used_prompt")
  logoDataUri    String   @map("logo_data_uri")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("professional_generations")
}

model ImageEditorGeneration {
  id                       String   @id @default(uuid())
  userId                   String   @map("user_id")
  sourceImageUri           String   @map("source_image_uri")
  sourceImageOriginalName  String?  @map("source_image_original_name")
  businessName             String   @map("business_name")
  businessDescription      String   @map("business_description")
  logoDataUri              String   @map("logo_data_uri")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("image_editor_generations")
}
